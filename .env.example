# Образец файла с настройками. Настоящие значения — в .env.local (он не попадает в git).

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (начинается с sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → секретный ключ (sb_secret_…). Только для сервера!
SUPABASE_SECRET_KEY=

# Stripe → Developers → API keys → Secret key (тестовый, sk_test_…)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → Signing secret (whsec_…), нужен для живого сайта
STRIPE_WEBHOOK_SECRET=

# Portfolio mode: "true" = no orders are saved and no payment is taken (live demo site)
NEXT_PUBLIC_PORTFOLIO_MODE=
