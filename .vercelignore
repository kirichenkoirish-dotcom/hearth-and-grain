# Файлы, которые не отправляются на Vercel при выкладке сайта.
# Секретные ключи — никогда не уходят с компьютера (на Vercel они заданы в настройках проекта)
.env
.env*
!.env.example

# Служебные файлы Supabase CLI и Claude
supabase/.temp
.claude

# Большие папки, которые Vercel создаёт сам при сборке — отправлять их не нужно
node_modules
.next
.git
.vercel
