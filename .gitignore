# Секретные ключи — никогда не попадают в git
.env
.env*
!.env.example

# Установленные библиотеки (ставятся заново командой npm install)
/node_modules
/.pnp
.pnp.*

# Файлы сборки Next.js
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Тесты
/coverage

# Логи и системный мусор
npm-debug.log*
.DS_Store
*.pem

# Личные заметки по проекту и настройки Claude — остаются только на компьютере, на GitHub не попадают
/CLAUDE.md
/.claude/
